    "test:e2e": "node scripts/test-e2e.mjs"
  },
  "dependencies": {
    "@vercel/sandbox": "3.3.0"
  },
  "devDependencies": {
    "@getpaseo/client": "0.8.0",
    "@getpaseo/plugin": "0.8.0",
    "@getpaseo/protocol": "0.8.0",
    "@types/node": "22.15.12",
    "@types/react": "19.2.14",
    "dts-bundle-generator": "9.5.1",
    "esbuild": "0.25.12",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=24"
  }
}
